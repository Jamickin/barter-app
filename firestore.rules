rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }
    
    // User profiles - users can read any profile but only edit their own
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Listings - anyone can read, only authenticated users can create
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isAuthenticated() && 
                     request.resource.data.by_user_id == request.auth.uid;
      // Owners edit their own listing. TODO before going live: accepting an offer also marks the
      // OTHER person's listing "pending"; move that into a Cloud Function so this rule can stay strict.
      // boosted_until is paid for, so only the payment server function (admin SDK) may set it.
      allow update: if isAuthenticated() &&
                     (resource.data.by_user_id == request.auth.uid || isAdmin()) &&
                     !request.resource.data.diff(resource.data).affectedKeys().hasAny(['boosted_until']);
      allow delete: if isAuthenticated() && 
                     (resource.data.by_user_id == request.auth.uid || isAdmin());
    }
    
    // Categories - anyone can read, only admins can modify
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Boost payments: written only by the server after the provider (e.g. Paynow) confirms payment.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    // Listing reports: anyone signed in can file one; only admins read them.
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Messages - only the two people in a conversation can see it.
    // The app queries with where('participants', 'array-contains', uid).
    match /messages/{messageId} {
      allow read: if isAuthenticated() &&
                   request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() &&
                     request.resource.data.from_user_id == request.auth.uid &&
                     request.resource.data.participants.hasAll([request.resource.data.from_user_id, request.resource.data.to_user_id]) &&
                     request.resource.data.participants.size() == 2;
      // Either side may mark read; offers can change status (accept / decline / withdraw).
      allow update: if isAuthenticated() &&
                     request.auth.uid in resource.data.participants &&
                     request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'offer']);
      allow delete: if isAdmin();
    }
  }
}